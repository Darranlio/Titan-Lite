# ==========================================
# Titan-Lite V2 环境变量配置模板
# ==========================================

# --- 1. LLM 核心配置 ---
# 切换 Provider: 'google' (推荐 Gemini) 或 'openai' (支持 DeepSeek)
LL_PROVIDER=google

# 如果使用 Gemini，请填写此项
GOOGLE_API_KEY=your_gemini_api_key_here

# 如果使用 DeepSeek 或 OpenAI，请填写以下两项
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# --- 2. 企业微信通知 (可选) ---
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID_PRIVATE=
WECOM_AGENT_ID_PUBLIC=

# --- 3. 策略参数 (可选，已有默认值) ---
SCREENER_MIN_UPSIDE=0.10
MACRO_VOL_THRESHOLD=0.35
